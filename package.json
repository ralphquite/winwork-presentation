{
  "name": "winwork-sales-demo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "doctor": "node scripts/doctor.mjs",
    "build": "tsc -b && vite build && vite build --config vite.court.config.ts && pnpm build:court:offline && pnpm build:onboarding:offline && pnpm build:sales:offline",
    "build:onboarding:offline": "vite build --config vite.onboarding-offline.config.ts && node scripts/package-offline-onboarding.mjs",
    "build:court:offline": "vite build --config vite.court-offline.config.ts && node scripts/package-offline-court.mjs",
    "preview": "vite preview",
    "auth:check": "node --experimental-strip-types scripts/check-auth.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -b --pretty false",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:quick": "pnpm docs:check && pnpm format:check && pnpm lint && pnpm typecheck && pnpm auth:check",
    "test": "pnpm test:e2e",
    "test:e2e": "playwright test smoke.spec.ts",
    "test:e2e:headed": "playwright test smoke.spec.ts --headed",
    "test:offline": "playwright test offline.spec.ts",
    "check": "pnpm check:quick && pnpm build && pnpm build:contracting:offline && pnpm test:e2e && pnpm test:offline && pnpm test:contracting",
    "build:sales:offline": "vite build --config vite.sales-offline.config.ts && node scripts/package-offline-sales.mjs",
    "build:contracting:offline": "node scripts/package-offline-contracting.mjs",
    "build:performers:offline": "node scripts/build-offline-performers.mjs",
    "test:contracting": "playwright test contracting.spec.ts",
    "build:contracting:reports": "node scripts/package-offline-contracting.mjs reports",
    "test:contracting:reports": "playwright test contracting-reports.spec.ts"
  },
  "dependencies": {
    "@vercel/functions": "^3.9.5",
    "lucide-react": "^1.33.0",
    "motion": "^13.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2"
  }
}
